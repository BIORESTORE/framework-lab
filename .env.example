# Pick ONE provider. With no key set, the engine uses the offline mock provider.
PROVIDER=openrouter           # openrouter | anthropic | openai | mock

# OpenRouter — one key, hundreds of models (https://openrouter.ai/keys).
# OpenAI-compatible; browse model slugs at https://openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=                # optional — used for OpenRouter's public rankings
# OPENROUTER_APP_NAME=framework-lab   # optional — used for OpenRouter's public rankings

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3030
